{
  "name": "factory",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsx scripts/compile.ts",
    "viewer": "tsx scripts/compile.ts --view",
    "test": "node scripts/build-sdk.ts && node --test 'packages/*/router/*.test.ts' 'packages/*/workers/*.test.ts' 'packages/*/deployer/*.test.ts' 'packages/*/runner/*.test.ts'",
    "build:sdk": "node scripts/build-sdk.ts",
    "prepare": "node scripts/build-sdk.ts"
  },
  "devDependencies": {
    "@notation/resource": "0.27.0",
    "@notation/std": "0.27.0",
    "@pokit/core": "^1.0.1",
    "@pokit/terminal": "^1.0.1",
    "@types/node": "^24.19.2",
    "pok-plugins": "github:djgrant/pok-plugins",
    "rolldown": "1.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "valibot": "^1.1.0",
    "wrangler": "4.151.0"
  }
}
