{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "factory": ["./packages/factory/index.ts"],
      "@factory/cloudflare": [
        "./packages/cloudflare/implementations/index.ts"
      ],
      "@factory/github": ["./packages/github/implementations/index.ts"],
      "@factory/slack": ["./packages/slack/implementations/index.ts"],
      "@factory/claude": ["./packages/claude/implementations/index.ts"],
      "@factory/railway": ["./packages/railway/implementations/index.ts"]
    }
  },
  "include": [
    "packages/*/index.ts",
    "packages/*/src/**/*.ts",
    "packages/*/resources/**/*.ts",
    "packages/*/implementations/**/*.ts",
    "packages/*/lib/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts"
  ]
}
