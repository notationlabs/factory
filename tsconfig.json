{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@notation/factory": [
        "./packages/factory/index.ts"
      ],
      "@notation/factory-cloudflare": [
        "./packages/cloudflare/implementations/index.ts"
      ],
      "@notation/factory-github": [
        "./packages/github/implementations/index.ts"
      ],
      "@notation/factory-slack": [
        "./packages/slack/implementations/index.ts"
      ],
      "@notation/factory-claude": [
        "./packages/claude/implementations/index.ts"
      ],
      "@notation/factory-droid": [
        "./packages/droid/implementations/index.ts"
      ],
      "@notation/factory-railway": [
        "./packages/railway/implementations/index.ts"
      ],
      "@notation/factory/deployer": [
        "./packages/factory/deployer/index.ts"
      ],
      "@notation/factory/router": [
        "./packages/factory/router/index.ts"
      ],
      "@notation/factory-github/router": [
        "./packages/github/router/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/index.ts",
    "packages/*/outpost.ts",
    "packages/*/deployer/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/resources/**/*.ts",
    "packages/*/implementations/**/*.ts",
    "packages/*/lib/**/*.ts",
    "packages/*/router/**/*.ts",
    "packages/*/runner/**/*.ts",
    "packages/*/workers/**/*.ts",
    "packages/*/bin/**/*.ts",
    "packages/*/commands/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts"
  ]
}
